# LearnGuage — statik site sunucu ayarlari (Apache / cPanel)

ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# Tek kanonik adres: https://learnguage.app (www yok, http yok).
# .app uzantisi HSTS preload listesinde — tarayici zaten HTTPS zorunlu tutuyor,
# bu kural sunucu tarafinda da ayni sonucu garanti eder.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://learnguage.app%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 1 hour"
ExpiresByType text/css "access plus 7 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
</IfModule>
